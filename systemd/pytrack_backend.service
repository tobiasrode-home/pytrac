[Unit]
Description=PyTrac Backend
After=network.target

[Service]
Type=simple
#User=tobi
WorkingDirectory=/opt/pytrac
Environment=SDL_VIDEODRIVER=kmsdrm
ExecStart=/usr/bin/python3 -m uvicorn pytrac_backend:app --host 0.0.0.0 --port 8000 --reload
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
