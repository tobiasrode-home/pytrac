APP_NAME=PyTrac Backend
ENVIRONMENT=development
DATABASE_URL=sqlite:///data/pytrac.db
HOST=127.0.0.1


NTRIP_URL=ntrip://sapos-he-ntrip.de:2101/DEIN_MOUNTPOINT
NTRIP_USERNAME=DEIN_BENUTZERNAME
NTRIP_PASSWORD=DEIN_PASSWORT
NTRIP_SEND_GGA=true

PORT=8000
#GPS_RECEIVER=zed_f9p
GPS_RECEIVER=legacy
GPS_PORT=/dev/serial/by-id/usb-Silicon_Labs_CP2104_USB_to_UART_Bridge_Controller_0202QWEE-if00-port0
GPS_BAUDRATE=9600

IMU_PORT=/dev/serial/by-id/usb-Silicon_Labs_CP2104_USB_to_UART_Bridge_Controller_02USX151-if00-port0
IMU_BAUDRATE=115200

SENSOR_OUTPUT_RATE_HZ=5

# Kivy-Client (Adresse des FastAPI-Backends)
KIVY_API_BASE_URL=http://127.0.0.1:8000
KIVY_API_TIMEOUT=5
KIVY_REFRESH_INTERVAL=1
